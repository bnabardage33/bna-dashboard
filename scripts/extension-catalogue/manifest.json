{
  "manifest_version": 3,
  "name": "BNA Catalogue Importer",
  "version": "1.0",
  "description": "Ajoute des matériaux depuis internet directement dans le catalogue BNA.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ajouter au catalogue BNA"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
