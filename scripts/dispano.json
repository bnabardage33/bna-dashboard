(async () => {
  const catalogue = new Map();

  function scrapperPage() {
    const cards = document.querySelectorAll('article, [class*="article"]');
    cards.forEach(card => {
      const text = card.innerText || '';
      if (!text) return;

      const title = card.querySelector('h2, h3, a[title], [class*="title"]')?.innerText?.trim() || text.split('\n')[0];
      const priceMatch = text.match(/(\d+[\s,.]?\d*)\s*€/);
      const price = priceMatch ? parseFloat(priceMatch[1].replace(',', '.').replace(/\s/g, '')) : null;
      const refMatch = text.match(/(?:Réf|Code|ID)\s*:?\s*(\d+)/i) || title.match(/A\d+/);
      const ref = refMatch ? refMatch[1] || refMatch[0] : null;

      if (title && title.length > 5 && ref) {
        catalogue.set(ref, {
          reference: ref,
          designation: title.replace(/\n+/g, ' '),
          prix_ttc: price,
          fournisseur: 'Dispano / Panofrance'
        });
      }
    });
    console.log(`📦 Total accumulé : ${catalogue.size} articles unique(s)`);
  }

  // 1. Scraping initial
  scrapperPage();

  // 2. Défilement automatique pour charger la suite (si infinite scroll)
  for (let i = 0; i < 5; i++) {
    window.scrollTo(0, document.body.scrollHeight);
    await new Promise(r => setTimeout(r, 1500)); // Pause de 1.5s
    scrapperPage();
    
    // Tentative de clic sur un bouton "Voir plus" ou "Suivant" s'il existe
    const btnSuivant = Array.from(document.querySelectorAll('button, a')).find(el => 
      /voir plus|suivant|load more/i.test(el.innerText)
    );
    if (btnSuivant) {
      btnSuivant.click();
      await new Promise(r => setTimeout(r, 2000));
      scrapperPage();
    }
  }

  const finalArray = Array.from(catalogue.values());
  console.log(`✅ EXTRACTION TERMINÉE : ${finalArray.length} articles récupérés !`);
  console.table(finalArray);
  
  // Exporter en JSON copiable directement
  console.log(JSON.stringify(finalArray));
  return finalArray;
})();
