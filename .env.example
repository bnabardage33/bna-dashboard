NEXT_PUBLIC_SUPABASE_URL=colle_ton_url_ici
NEXT_PUBLIC_SUPABASE_ANON_KEY=colle_ta_cle_anon_ici
SUPABASE_SERVICE_ROLE_KEY=colle_ta_cle_service_role_ici
VISUALCROSSING_API_KEY=ta_cle_ici
GOOGLE_GENERATIVE_AI_API_KEY=ta_cle_google_ici
METEOFRANCE_APPLICATION_ID=ta_cle_ici
FINANCE_PIN=ton_pin_ici
GROQ_API_KEY=ta_cle_groq
GROQ_MODEL=openai/gpt-oss-20b
# Secret des crons Vercel : obligatoire pour que /api/cron/meteo et
# /api/rapports-client/auto répondent aux appels Vercel Cron
# (Vercel envoie automatiquement Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=change_ce_secret_long_aleatoire

# Contact exigé par la politique d'utilisation de Nominatim
# (operations.osmfoundation.org/policies/nominatim/) : leur User-Agent doit
# porter une adresse joignable. Utilisé par le calcul de trajet des frais de
# déplacement, dans le User-Agent des appels à openstreetmap.
# À définir aussi dans les variables d'environnement Vercel, sinon les
# appels partent sans email et le service peut être bloqué à tout moment.
NOMINATIM_EMAIL=ton_email_pro_ici
