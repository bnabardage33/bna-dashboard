# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env.local*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# credentials de test locaux
**/.creds.json

# dev scripts (one-off patches, do not commit)
# Les motifs à joker sont bornés à /.archive-scripts/ : sans « / » initial
# ils s'appliqueraient à TOUT le dépôt, et un futur app/lib/fix_bruit.js
# serait ignoré SANS PRÉVENIR (ni commité, ni visible dans git status).
/.archive-scripts/patch_*.js
/.archive-scripts/fix_*.js
/.archive-scripts/check_*.js
/.archive-scripts/count_*.js
/.archive-scripts/find_*.js
/.archive-scripts/trace_*.js
/.archive-scripts/print_*.js
# Noms fixes, sans joker : le risque de collision avec un fichier source
# est nul, ils restent donc valables partout.
inject_ui.js
globalCalepinage.js
.env.check
# supabase cli temporary artifacts
/supabase/.temp/
/scratch/
.env*
